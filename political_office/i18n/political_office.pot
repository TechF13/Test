#. module: political_office
#: model:mail.template,body_html:political_office.mail_template_request_received
msgid ""
"<div>\n"
"    Sayın <t t-out=\"object.partner_id.name or 'Vatandaşımız'\">Ayşe Demir</t>,<br/><br/>\n"
"    \"<t t-out=\"object.name\">Mahalle yolunun asfaltlanması</t>\" konulu talebiniz\n"
"    <t t-out=\"object.id\">42</t> numarasıyla kayda alınmıştır. Ekibimiz talebinizi inceleyerek\n"
"    en kısa sürede size dönüş yapacaktır.<br/><br/>\n"
"    Saygılarımızla,<br/>\n"
"    <t t-out=\"object.company_id.name or ''\">Ofis</t>\n"
"</div>\n"
"        "
msgstr ""

#. module: political_office
#: model:mail.template,body_html:political_office.mail_template_request_solved
msgid ""
"<div>\n"
"    Sayın <t t-out=\"object.partner_id.name or 'Vatandaşımız'\">Ayşe Demir</t>,<br/><br/>\n"
"    \"<t t-out=\"object.name\">Mahalle yolunun asfaltlanması</t>\" konulu talebiniz sonuçlanmıştır.\n"
"    Bize ulaştığınız için teşekkür ederiz.<br/><br/>\n"
"    Saygılarımızla,<br/>\n"
"    <t t-out=\"object.company_id.name or ''\">Ofis</t>\n"
"</div>\n"
"        "
msgstr ""

#. module: political_office
#: model:mail.template,body_html:political_office.mail_template_request_forwarded
msgid ""
"<div>\n"
"    Sayın <t t-out=\"object.partner_id.name or 'Vatandaşımız'\">Ayşe Demir</t>,<br/><br/>\n"
"    <t t-out=\"object.id\">42</t> numaralı talebiniz\n"
"    <t t-if=\"object.political_institution_id\"><t t-out=\"object.political_institution_id.name\">Belediye</t> kurumuna</t>\n"
"    <t t-else=\"\">ilgili kuruma</t>\n"
"    iletilmiştir. Süreci takip ederek sizi bilgilendirmeye devam edeceğiz.<br/><br/>\n"
"    Saygılarımızla,<br/>\n"
"    <t t-out=\"object.company_id.name or ''\">Ofis</t>\n"
"</div>\n"
"        "
msgstr ""

