<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_political_office" model="res.groups.privilege">
        <field name="name">Siyasi Ofis</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_political_user" model="res.groups">
        <field name="name">Kullanıcı</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_political_office"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')), Command.link(ref('project.group_project_user'))]"/>
        <field name="comment">Talepleri, ajandayı ve haberleri görür ve işler.</field>
    </record>

    <record id="group_political_manager" model="res.groups">
        <field name="name">Yönetici</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_political_office"/>
        <field name="implied_ids" eval="[Command.link(ref('group_political_user')), Command.link(ref('project.group_project_manager'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
        <field name="comment">Haber kaynaklarını, anahtar kelimeleri, aşamaları ve AI ayarlarını yönetir.</field>
    </record>

    <record id="political_news_report_company_rule" model="ir.rule">
        <field name="name">Basın Bülteni: çoklu şirket</field>
        <field name="model_id" ref="model_political_news_report"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
