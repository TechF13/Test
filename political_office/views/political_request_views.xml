<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stages & categories -->
    <record id="political_request_stage_view_list" model="ir.ui.view">
        <field name="name">political.request.stage.list</field>
        <field name="model">political.request.stage</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="fold"/>
                <field name="is_closed"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="action_political_request_stage" model="ir.actions.act_window">
        <field name="name">Talep Aşamaları</field>
        <field name="res_model">political.request.stage</field>
        <field name="view_mode">list</field>
    </record>

    <record id="political_request_category_view_list" model="ir.ui.view">
        <field name="name">political.request.category.list</field>
        <field name="model">political.request.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="sla_days"/>
                <field name="default_user_id" widget="many2one_avatar_user"/>
                <field name="color" widget="color_picker"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="action_political_request_category" model="ir.actions.act_window">
        <field name="name">Talep Kategorileri</field>
        <field name="res_model">political.request.category</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Requests -->
    <record id="political_request_view_form" model="ir.ui.view">
        <field name="name">political.request.form</field>
        <field name="model">political.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_schedule_meeting" type="object" string="Randevu Planla" class="btn-primary" icon="fa-calendar"/>
                    <button name="action_ai_analyze" type="object" string="AI ile Analiz Et" icon="fa-magic"/>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1', 'fold_field': 'fold'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_events" type="object" class="oe_stat_button" icon="fa-calendar" invisible="not event_count">
                            <field name="event_count" widget="statinfo" string="Randevu"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Gecikmiş" bg_color="text-bg-danger" invisible="not is_overdue"/>
                    <widget name="web_ribbon" title="Arşivlendi" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <field name="is_closed" invisible="1"/>
                    <div class="oe_title">
                        <field name="reference" readonly="1" class="text-muted"/>
                        <h1>
                            <field name="priority" widget="priority" class="me-2"/>
                            <field name="name" placeholder="ör. Mahalle yolunun asfaltlanması"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Başvuru Sahibi">
                            <field name="partner_id" context="{'default_political_contact_type': 'citizen', 'default_constituency_id': constituency_id}"/>
                            <field name="contact_phone" widget="phone"/>
                            <field name="contact_email" widget="email"/>
                            <field name="constituency_id"/>
                            <field name="channel"/>
                        </group>
                        <group string="Takip">
                            <field name="category_id" options="{'no_create': True}"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="date_received"/>
                            <field name="date_deadline" decoration-danger="is_overdue"/>
                            <field name="date_closed" invisible="not date_closed"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Talep Detayı" name="description">
                            <field name="description" placeholder="Vatandaşın talebini ayrıntılı olarak yazın..."/>
                        </page>
                        <page string="Yönlendirme ve Sonuç" name="resolution">
                            <group>
                                <group>
                                    <field name="institution_partner_id" context="{'default_is_company': True, 'default_political_contact_type': 'institution'}"/>
                                    <field name="institution_ref"/>
                                </group>
                                <group>
                                    <field name="satisfaction" widget="priority" invisible="not is_closed"/>
                                    <field name="resolution_days" invisible="not is_closed"/>
                                </group>
                            </group>
                            <field name="resolution" placeholder="Yapılan işlemler ve sonuç..."/>
                        </page>
                        <page string="Yapay Zekâ" name="ai">
                            <group>
                                <field name="ai_summary"/>
                                <field name="ai_draft_reply" widget="text"/>
                            </group>
                        </page>
                        <page string="Bağlantılar" name="links">
                            <group>
                                <field name="article_id"/>
                                <field name="event_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="political_request_view_list" model="ir.ui.view">
        <field name="name">political.request.list</field>
        <field name="model">political.request</field>
        <field name="arch" type="xml">
            <list multi_edit="1" decoration-danger="is_overdue" decoration-muted="is_closed">
                <field name="priority" widget="priority" optional="show" nolabel="1"/>
                <field name="reference" optional="show"/>
                <field name="name"/>
                <field name="partner_id" optional="show"/>
                <field name="constituency_id" optional="show"/>
                <field name="category_id" optional="show"/>
                <field name="channel" optional="hide"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="date_received" optional="hide"/>
                <field name="date_deadline" optional="show"/>
                <field name="stage_id"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="is_overdue" column_invisible="True"/>
                <field name="is_closed" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="political_request_view_kanban" model="ir.ui.view">
        <field name="name">political.request.kanban</field>
        <field name="model">political.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column" highlight_color="color" quick_create="false">
                <field name="is_overdue"/>
                <progressbar field="priority" colors='{"3": "danger", "2": "warning", "1": "info", "0": "muted"}'/>
                <templates>
                    <t t-name="card">
                        <field name="reference" class="text-muted small"/>
                        <field name="name" class="fw-bold fs-5"/>
                        <field name="partner_id"/>
                        <div class="d-flex flex-wrap gap-1 small text-muted">
                            <field name="constituency_id"/>
                            <field name="category_id"/>
                        </div>
                        <div t-if="record.is_overdue.raw_value" class="text-danger small">
                            <i class="fa fa-clock-o me-1"/>Gecikmiş: <field name="date_deadline"/>
                        </div>
                        <footer>
                            <div class="d-flex">
                                <field name="priority" widget="priority" class="me-2"/>
                                <field name="activity_ids" widget="kanban_activity"/>
                            </div>
                            <div class="d-flex ms-auto align-items-center">
                                <field name="user_id" widget="many2one_avatar_user"/>
                            </div>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="political_request_view_search" model="ir.ui.view">
        <field name="name">political.request.search</field>
        <field name="model">political.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Talep" filter_domain="['|', ('name', 'ilike', self), ('reference', 'ilike', self)]"/>
                <field name="partner_id"/>
                <field name="constituency_id" operator="child_of"/>
                <field name="category_id"/>
                <field name="user_id"/>
                <field name="institution_partner_id"/>
                <filter string="Taleplerim" name="my_requests" domain="[('user_id', '=', uid)]"/>
                <filter string="Atanmamış" name="unassigned" domain="[('user_id', '=', False)]"/>
                <separator/>
                <filter string="Açık" name="open" domain="[('is_closed', '=', False)]"/>
                <filter string="Kapalı" name="closed" domain="[('is_closed', '=', True)]"/>
                <filter string="Gecikmiş" name="overdue" domain="[('is_overdue', '=', True)]"/>
                <filter string="Acil" name="urgent" domain="[('priority', 'in', ['2', '3'])]"/>
                <separator/>
                <filter string="Alınma Tarihi" name="filter_date_received" date="date_received"/>
                <separator/>
                <filter string="Arşivlenmiş" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Aşama" name="group_stage" context="{'group_by': 'stage_id'}"/>
                    <filter string="Kategori" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Bölge" name="group_constituency" context="{'group_by': 'constituency_id'}"/>
                    <filter string="Kanal" name="group_channel" context="{'group_by': 'channel'}"/>
                    <filter string="Sorumlu" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Kurum" name="group_institution" context="{'group_by': 'institution_partner_id'}"/>
                    <filter string="Alınma Tarihi" name="group_date_received" context="{'group_by': 'date_received:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="political_request_view_pivot" model="ir.ui.view">
        <field name="name">political.request.pivot</field>
        <field name="model">political.request</field>
        <field name="arch" type="xml">
            <pivot string="Talep Analizi" sample="1">
                <field name="category_id" type="row"/>
                <field name="stage_id" type="col"/>
                <field name="resolution_days" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="political_request_view_graph" model="ir.ui.view">
        <field name="name">political.request.graph</field>
        <field name="model">political.request</field>
        <field name="arch" type="xml">
            <graph string="Talep Analizi" type="bar" stacked="1" sample="1">
                <field name="date_received" interval="month"/>
                <field name="category_id"/>
            </graph>
        </field>
    </record>

    <record id="political_request_view_calendar" model="ir.ui.view">
        <field name="name">political.request.calendar</field>
        <field name="model">political.request</field>
        <field name="arch" type="xml">
            <calendar string="Talep Termin Takvimi" date_start="date_deadline" color="user_id" mode="month" quick_create="0">
                <field name="partner_id"/>
                <field name="stage_id"/>
            </calendar>
        </field>
    </record>

    <record id="political_request_view_activity" model="ir.ui.view">
        <field name="name">political.request.activity</field>
        <field name="model">political.request</field>
        <field name="arch" type="xml">
            <activity string="Talepler">
                <templates>
                    <div t-name="activity-box">
                        <field name="name" class="fw-bold"/>
                        <field name="partner_id" muted="1"/>
                    </div>
                </templates>
            </activity>
        </field>
    </record>

    <record id="action_political_request" model="ir.actions.act_window">
        <field name="name">Vatandaş Talepleri</field>
        <field name="res_model">political.request</field>
        <field name="path">political-requests</field>
        <field name="view_mode">kanban,list,form,calendar,pivot,graph,activity</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">İlk vatandaş talebini kaydedin</p>
            <p>Ofise, telefona, e-postaya veya sahaya gelen tüm talepleri buradan takip edin.</p>
        </field>
    </record>

    <record id="action_political_request_analysis" model="ir.actions.act_window">
        <field name="name">Talep Analizi</field>
        <field name="res_model">political.request</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="context">{}</field>
    </record>
</odoo>
