<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Citizen requests reuse the standard Project task views; only the
         political fields and buttons are added on top. -->
    <record id="project_task_view_form_inherit_political" model="ir.ui.view">
        <field name="name">project.task.form.inherit.political</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="is_political_request" invisible="1"/>
                <button name="action_political_schedule_meeting" type="object" string="Randevu Planla" icon="fa-calendar"
                        invisible="not is_political_request" groups="political_office.group_political_user"/>
                <button name="action_political_ai_analyze" type="object" string="AI ile Analiz Et" icon="fa-magic"
                        invisible="not is_political_request" groups="political_office.group_political_user"/>
            </xpath>
            <div name="button_box" position="inside">
                <button name="action_political_view_events" type="object" class="oe_stat_button" icon="fa-calendar"
                        invisible="not political_event_count" groups="political_office.group_political_user">
                    <field name="political_event_count" widget="statinfo" string="Randevu"/>
                </button>
            </div>
            <field name="partner_id" position="after">
                <field name="constituency_id" invisible="not is_political_request" groups="political_office.group_political_user"/>
                <field name="political_channel" invisible="not is_political_request" groups="political_office.group_political_user"/>
            </field>
            <page name="description_page" position="after">
                <page name="political_request" string="Talep Takibi" invisible="not is_political_request"
                      groups="political_office.group_political_user">
                    <group>
                        <group string="Kuruma Yönlendirme">
                            <field name="political_institution_id"/>
                            <field name="political_institution_ref"/>
                            <field name="political_article_id"/>
                        </group>
                        <group string="Yapay Zekâ">
                            <field name="political_ai_summary"/>
                            <field name="political_ai_draft_reply" widget="text"/>
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>

    <record id="project_task_view_search_inherit_political" model="ir.ui.view">
        <field name="name">project.task.search.inherit.political</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form_base"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="constituency_id" operator="child_of" groups="political_office.group_political_user"/>
                <field name="political_institution_id" groups="political_office.group_political_user"/>
                <filter string="Bölge" name="group_constituency" context="{'group_by': 'constituency_id'}"
                        groups="political_office.group_political_user"/>
                <filter string="Başvuru Kanalı" name="group_political_channel" context="{'group_by': 'political_channel'}"
                        groups="political_office.group_political_user"/>
            </xpath>
        </field>
    </record>

    <record id="project_view_form_inherit_political" model="ir.ui.view">
        <field name="name">project.project.form.inherit.political</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <field name="label_tasks" position="after">
                <field name="is_political_request" groups="political_office.group_political_manager"/>
            </field>
        </field>
    </record>

    <record id="project_tags_view_list_inherit_political" model="ir.ui.view">
        <field name="name">project.tags.list.inherit.political</field>
        <field name="model">project.tags</field>
        <field name="inherit_id" ref="project.project_tags_tree_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="political_sla_days" optional="show" groups="political_office.group_political_user"/>
            </field>
        </field>
    </record>

    <record id="action_political_request" model="ir.actions.act_window">
        <field name="name">Vatandaş Talepleri</field>
        <field name="res_model">project.task</field>
        <field name="path">political-requests</field>
        <field name="view_mode">kanban,list,form,calendar,pivot,graph,activity</field>
        <field name="domain">[('project_id.is_political_request', '=', True)]</field>
        <field name="context" eval="{'default_project_id': ref('project_citizen_requests'), 'search_default_open_tasks': 1}"/>
        <field name="search_view_id" ref="project.view_task_search_form"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">İlk vatandaş talebini kaydedin</p>
            <p>Ofise, telefona, e-postaya veya sahaya gelen tüm talepleri buradan takip edin.</p>
        </field>
    </record>

    <record id="action_political_request_analysis" model="ir.actions.act_window">
        <field name="name">Talep Analizi</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="domain">[('project_id.is_political_request', '=', True)]</field>
        <field name="context">{'graph_groupbys': ['create_date:month', 'tag_ids']}</field>
        <field name="search_view_id" ref="project.view_task_search_form"/>
    </record>

    <record id="action_political_request_tags" model="ir.actions.act_window">
        <field name="name">Talep Kategorileri</field>
        <field name="res_model">project.tags</field>
        <field name="view_mode">list</field>
        <field name="domain">[('political_sla_days', '>', 0)]</field>
        <field name="help" type="html">
            <p>Çözüm süresi tanımlı proje etiketleri talep kategorisi olarak kullanılır.</p>
        </field>
    </record>
</odoo>
