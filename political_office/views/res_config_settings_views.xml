<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_political" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.political</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="60"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Political Office" string="Political Office" name="political_office" groups="political_office.group_political_manager">
                    <block title="Politician Profile" name="political_profile">
                        <setting string="Profile" help="Used as context by the AI analyses.">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label for="political_politician_name" class="col-lg-4 o_light_label"/>
                                    <field name="political_politician_name"/>
                                </div>
                                <div class="row">
                                    <label for="political_politician_title" class="col-lg-4 o_light_label"/>
                                    <field name="political_politician_title" placeholder="e.g. Member of Parliament for Ankara"/>
                                </div>
                                <div class="row">
                                    <label for="political_politician_party" class="col-lg-4 o_light_label"/>
                                    <field name="political_politician_party"/>
                                </div>
                                <div class="row">
                                    <label for="political_politician_region" class="col-lg-4 o_light_label"/>
                                    <field name="political_politician_region"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="AI (Claude)" name="political_ai">
                        <setting string="Anthropic API" help="Used for news summaries, tagging, sentiment analysis and bulletins.">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label for="political_anthropic_api_key" class="col-lg-4 o_light_label"/>
                                    <field name="political_anthropic_api_key" password="True"/>
                                </div>
                                <div class="row">
                                    <label for="political_ai_model" class="col-lg-4 o_light_label"/>
                                    <field name="political_ai_model"/>
                                </div>
                                <div class="mt-2">
                                    <field name="political_ai_use_env_credentials" class="oe_inline"/>
                                    <label for="political_ai_use_env_credentials" class="o_light_label"/>
                                </div>
                            </div>
                        </setting>
                        <setting help="New articles are analyzed in the background every 15 minutes.">
                            <field name="political_ai_auto_process"/>
                            <div class="content-group" invisible="not political_ai_auto_process">
                                <div class="row mt-2">
                                    <label for="political_ai_batch_size" class="col-lg-6 o_light_label"/>
                                    <field name="political_ai_batch_size"/>
                                </div>
                            </div>
                        </setting>
                        <setting help="When existing tags are not enough, the AI can create up to 2 new tags.">
                            <field name="political_ai_allow_new_tags"/>
                        </setting>
                    </block>
                    <block title="Citizen Requests" name="political_requests">
                        <setting help="Citizens can send requests directly from the form at /talep on your website.">
                            <field name="political_public_form_enabled"/>
                            <div class="content-group mt-2" invisible="not political_public_form_enabled">
                                <a href="/talep" target="_blank" role="button" class="btn-link"><i class="fa fa-arrow-right"/> View the form</a>
                            </div>
                        </setting>
                    </block>
                    <block title="Media Alerts" name="political_alerts">
                        <setting string="Instant Alert" help="Articles rated important by the AI analysis are notified to the selected users immediately.">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label for="political_alert_level" class="col-lg-4 o_light_label"/>
                                    <field name="political_alert_level"/>
                                </div>
                                <div class="row" invisible="political_alert_level == 'off'">
                                    <label for="political_alert_user_ids" class="col-lg-4 o_light_label"/>
                                    <field name="political_alert_user_ids" widget="many2many_tags"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Daily Press Bulletin" name="political_digest">
                        <setting string="Bulletin" help="Every morning the bulletin of the last 24 hours is generated and sent to these users.">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label for="political_digest_user_ids" class="col-lg-4 o_light_label"/>
                                    <field name="political_digest_user_ids" widget="many2many_tags"/>
                                </div>
                                <div class="row">
                                    <label for="political_digest_min_relevance" class="col-lg-4 o_light_label"/>
                                    <field name="political_digest_min_relevance"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_political_office_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'political_office', 'bin_size': False}</field>
    </record>
</odoo>
