<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Contact types are standard contact tags; requests use the standard
         Tasks smart button added by Project. Only the constituency is added. -->
    <record id="res_partner_view_form_inherit_political" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.political</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="constituency_id" groups="political_office.group_political_user"/>
            </field>
        </field>
    </record>

    <record id="res_partner_view_search_inherit_political" model="ir.ui.view">
        <field name="name">res.partner.search.inherit.political</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="constituency_id" operator="child_of" groups="political_office.group_political_user"/>
            </field>
        </field>
    </record>
</odoo>
