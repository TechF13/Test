<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="channel_political_office" model="queue.job.channel">
        <field name="name">political_office</field>
        <field name="parent_id" ref="queue_job.channel_root"/>
    </record>

    <record id="job_function_fetch_articles" model="queue.job.function">
        <field name="model_id" ref="political_office.model_political_news_source"/>
        <field name="method">_job_fetch_articles</field>
        <field name="channel_id" ref="channel_political_office"/>
        <field name="retry_pattern" eval="{1: 60, 3: 300, 5: 1800}"/>
    </record>

    <record id="job_function_ai_analyze" model="queue.job.function">
        <field name="model_id" ref="political_office.model_political_news_article"/>
        <field name="method">_job_ai_analyze</field>
        <field name="channel_id" ref="channel_political_office"/>
        <field name="retry_pattern" eval="{1: 120, 3: 600}"/>
    </record>
</odoo>
